{
  "name": "geofencing-platform",
  "private": true,
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:web": "npm run dev --workspace=web",
    "simulate:location": "node scripts/simulate-location.mjs",
    "build": "npm run build --workspace=web",
    "build:api": "go -C apps/api build -o bin/server ./cmd/server",
    "test": "npm run lint --workspace=web && npm run test:api",
    "test:api": "go -C apps/api test ./...",
    "lint": "npm run lint --workspace=web"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
